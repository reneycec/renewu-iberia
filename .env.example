# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE PAYMENT INTEGRATION (Production)
# Configure these when connecting a live Stripe account
STRIPE_SECRET_KEY="sk_live_..."
VITE_STRIPE_PUBLIC_KEY="pk_live_..."

# MOODLE REST API INTEGRATION
MOODLE_URL="https://moodle.renew.edu/webservice/rest/server.php"
MOODLE_WS_TOKEN="wstoken_demo_renewu_9876543210"

